<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.5.2</Version>
    <DistributionFlavor Condition="'$(DistributionFlavor)' == ''">full</DistributionFlavor>
    <AssemblyTitle>Primary Wallpaper Agent</AssemblyTitle>
    <Product>Primary Wallpaper Agent</Product>
    <Description>Use a primary wallpaper and a shared secondary wallpaper, with black as the default.</Description>
    <ApplicationIcon>../../assets/branding/Application.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PrimaryWallpaperAgent.Core/PrimaryWallpaperAgent.Core.csproj" />
    <EmbeddedResource Include="../../assets/branding/*.ico" LogicalName="PrimaryWallpaperAgent.Tray.Branding.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../assets/licenses/ThirdPartyNotices.txt" LogicalName="PrimaryWallpaperAgent.ThirdPartyNotices" />
    <EmbeddedResource Include="../../assets/updates/update-public-key.pem" LogicalName="PrimaryWallpaperAgent.UpdatePublicKey" />
    <AssemblyMetadata Include="DistributionFlavor" Value="$(DistributionFlavor)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
</Project>
