<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.4.3</Version>
    <DistributionFlavor Condition="'$(DistributionFlavor)' == ''">full</DistributionFlavor>
    <AssemblyTitle>Primary Wallpaper Agent</AssemblyTitle>
    <Product>Primary Wallpaper Agent</Product>
    <Description>Show wallpaper on the primary display and keep other displays black.</Description>
    <ApplicationIcon>../../assets/branding/Application.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PrimaryWallpaperAgent.Core/PrimaryWallpaperAgent.Core.csproj" />
    <EmbeddedResource Include="../../assets/branding/*.ico" LogicalName="PrimaryWallpaperAgent.Tray.Branding.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../assets/updates/update-public-key.pem" LogicalName="PrimaryWallpaperAgent.UpdatePublicKey" />
    <AssemblyMetadata Include="DistributionFlavor" Value="$(DistributionFlavor)" />
  </ItemGroup>
</Project>