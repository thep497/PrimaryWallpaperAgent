<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <!-- Test fixtures bundle the Tray assembly, not its executable deployment. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/PrimaryWallpaperAgent.Core/PrimaryWallpaperAgent.Core.csproj" />
    <ProjectReference Include="../../src/PrimaryWallpaperAgent.Tray/PrimaryWallpaperAgent.Tray.csproj" />
  </ItemGroup>
</Project>